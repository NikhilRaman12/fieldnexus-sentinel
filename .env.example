# KRISHIVA AI — Environment Configuration Template
# Copy this file to .env and populate with your verified credentials.
# NEVER commit the active .env file or real credentials to source control.

# Application Environment
ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Configuration (PostgreSQL primary with PostGIS, SQLite local fallback)
DATABASE_URL=sqlite:///./krishiva_local.db
# DATABASE_URL=postgresql+psycopg2://krishiva_user:krishiva_password@localhost:5432/krishiva_db

# Google Gemini / Google AI Credentials
# Get an API key from https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Weather Services (Open-Meteo is key-free by default; IMD/secondary provider key if used)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=optional_weather_api_key

# Agricultural Market Intelligence (data.gov.in / e-NAM API)
# Register at https://data.gov.in to obtain an official API key
DATA_GOV_IN_API_KEY=your_datagov_in_api_key_here
ENAM_BASE_URL=https://enam.gov.in/web/trading-details

# Earth Observation / Satellite
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_PRIVATE_KEY_PATH=

# Core Directories
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
OUTPUT_REPORTS_DIR=outputs/reports
OUTPUT_CONFIG_DIR=configs

# ML Training & Evaluation
DEFAULT_MODEL=random_forest
TEST_SIZE=0.2
RANDOM_STATE=42
